{
  "name": "harmoniq",
  "version": "1.0.0",
  "private": true,
  "description": "Harmoniq - Micro Frontend Control Plane",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:local": "node scripts/dev-local.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "pnpm --filter @harmoniq/db db:migrate",
    "db:seed": "pnpm --filter @harmoniq/db db:seed",
    "db:studio": "pnpm --filter @harmoniq/db db:studio",
    "changeset": "changeset",
    "version": "changeset version",
    "prepare": "husky",
    "changelog:check": "bash scripts/changelog-check.sh",
    "db:deploy": "pnpm --filter @harmoniq/db db:deploy",
    "docker:demo": "docker compose -f docker/docker-compose.yml --profile app up -d --build",
    "docker:demo:down": "docker compose -f docker/docker-compose.yml --profile app down"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@harmoniq/tsconfig": "workspace:^",
    "@types/node": "^20.12.7",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "^1.31.0",
      "proxy-addr": "^2.0.8",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "@grpc/grpc-js@1": "^1.14.5",
      "basic-ftp": "^6.2.1",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5"
    }
  }
}
