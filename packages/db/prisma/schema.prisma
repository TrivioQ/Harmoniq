generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime tenant role (harmoniq_app): always subject to Row-Level Security.
  url       = env("DATABASE_URL")
  // Schema owner (harmoniq): used by `prisma migrate` and by systemDb at runtime.
  directUrl = env("SYSTEM_DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  avatarUrl           String?
  lastLoginAt         DateTime?
  /// SES-04: set by an instance admin; sign-in, sessions and the user's keys are refused.
  suspendedAt         DateTime?
  suspendedReason     String?
  /// SES-03: the TOTP secret (sealed); MFA is on once `mfaEnabledAt` is set.
  mfaSecretSealed     String?
  mfaEnabledAt        DateTime?
  /// sha256 of each unused recovery code.
  mfaRecoveryCodes    String[]             @default([])
  /// The last TOTP time step accepted (a code can't be replayed).
  mfaLastStep         Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  Identities          Identity[]
  WorkspaceMembers    WorkspaceMember[]
  ApiKeys             ApiKey[]
  RefreshTokens       RefreshToken[]
  OrganizationMembers OrganizationMember[]
  InstanceAdmin       InstanceAdmin?
  ScimUsers           ScimUser[]
}

model Workspace {
  id                         String                  @id @default(cuid())
  slug                       String                  @unique
  name                       String
  organizationId             String?
  retentionDays              Int                     @default(90)
  /// Let deploys create short-lived preview environments (e.g. `pr-123`).
  allowEphemeralEnvironments Boolean                 @default(false)
  /// INST-09: set by an instance admin; writes are refused, manifests are still served.
  suspendedAt                DateTime?
  suspendedReason            String?
  /// TLC-02: deleted, restorable until `purgeAfter`; refused with 410, manifests included.
  deletedAt                  DateTime?
  deletedBy                  String?
  /// TLC-03: the `tenant.purge` job deletes the workspace and its objects after this.
  purgeAfter                 DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  organization               Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  WorkspaceMembers           WorkspaceMember[]
  HostApps                   HostApp[]
  RemoteModules              RemoteModule[]
  ModuleVersions             ModuleVersion[]
  ApiKeys                    ApiKey[]
  WebhookEndpoints           WebhookEndpoint[]
  WebhookDeliveries          WebhookDelivery[]
  WorkspaceConfig            WorkspaceConfig?
  WorkspaceStorageConfig     WorkspaceStorageConfig?
  ModuleOwnerships           ModuleOwnership[]
  AlertRules                 AlertRule[]
  ManifestSnapshots          ManifestSnapshot[]
  WebhookDeadLetters         WebhookDeadLetter[]
  ModuleHealthEvents         ModuleHealthEvent[]
  ModuleHealthRollups        ModuleHealthRollup[]
  ModuleEnvStates            ModuleEnvState[]
  ScheduledOperations        ScheduledOperation[]
  ScimUsers                  ScimUser[]
  ScimGroups                 ScimGroup[]
  ApprovalPolicies           ApprovalPolicy[]
  VerifiedDomains            VerifiedDomain[]
  DeploymentRequests         DeploymentRequest[]

  @@index([purgeAfter])
}

enum Role {
  owner
  admin
  developer
  viewer
}

model WorkspaceMember {
  id               String            @id @default(cuid())
  workspaceId      String
  userId           String
  role             Role
  invitedAt        DateTime          @default(now())
  joinedAt         DateTime?
  /// ORG-07: granted by the organization's group rules (SSO or SCIM), which also remove it.
  orgProvisioned   Boolean           @default(false)
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ModuleOwnerships ModuleOwnership[]

  @@unique([workspaceId, userId])
}

model HostApp {
  id                 String             @id @default(cuid())
  workspaceId        String
  name               String
  slug               String
  description        String?
  /// Served by the legacy `GET /api/manifest/:workspaceSlug/:env` endpoint (HST-02).
  isDefault          Boolean            @default(false)
  /// Link to a preview of the host, e.g. `https://staging.acme.com/?harmoniq-env={environment}`.
  previewUrlTemplate String?
  /// M3.7: dependencies the host shares with every module (package → semver range).
  sharedDependencies Json?
  /// M3.7: reject deploys that drop an exposed module the active version had.
  strictExposes      Boolean            @default(false)
  createdAt          DateTime           @default(now())
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Environments       Environment[]
  RemoteModules      RemoteModule[]
  ManifestSnapshots  ManifestSnapshot[]

  @@unique([workspaceId, slug])
}

model Environment {
  id                   String               @id @default(cuid())
  hostAppId            String
  name                 String
  slug                 String
  isDefault            Boolean              @default(false)
  frozenAt             DateTime?
  frozenBy             String?
  freezeReason         String?
  /// ENV-FRZ-04: a scheduled freeze starts here (null: as soon as it is set).
  freezeFrom           DateTime?
  freezeUntil          DateTime?
  /// ENV-FRZ-03: an owner lets changes through a freeze until then, for a reason.
  freezeOverrideUntil  DateTime?
  freezeOverrideReason String?
  freezeOverrideBy     String?
  /// Last manifest copy written to storage/CDN (M2.1); hosts can read it without the registry.
  lastPublishedEtag    String?
  lastPublishedAt      DateTime?
  lastPublishError     String?
  /// Preview environment created by a deploy; deleted after `expiresAt`.
  ephemeral            Boolean              @default(false)
  expiresAt            DateTime?
  hostApp              HostApp              @relation(fields: [hostAppId], references: [id], onDelete: Cascade)
  ModuleVersions       ModuleVersion[]
  ManifestSnapshots    ManifestSnapshot[]
  ModuleHealthEvents   ModuleHealthEvent[]
  ModuleHealthRollups  ModuleHealthRollup[]
  AlertRules           AlertRule[]
  ModuleEnvStates      ModuleEnvState[]

  @@unique([hostAppId, slug])
  @@index([ephemeral, expiresAt])
}

model RemoteModule {
  id                  String               @id @default(cuid())
  workspaceId         String
  hostAppId           String
  name                String
  slug                String
  description         String?
  /// Import-map specifier, e.g. `@acme/checkout` (IMP-03). Defaults to the slug.
  specifier           String?
  /// ORG-10: listed in the manifests of the organization's other workspaces.
  orgShared           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostApp             HostApp              @relation(fields: [hostAppId], references: [id], onDelete: Cascade)
  ModuleVersions      ModuleVersion[]
  ModuleOwnerships    ModuleOwnership[]
  ModuleHealthEvents  ModuleHealthEvent[]
  ModuleHealthRollups ModuleHealthRollup[]
  AlertRules          AlertRule[]
  ModuleEnvStates     ModuleEnvState[]

  @@unique([hostAppId, slug])
  @@index([workspaceId, slug])
}

enum ModuleVersionStatus {
  active
  inactive
  canary
  orphaned
}

enum ActorType {
  user
  apiKey
  /// Background jobs, e.g. an alert's auto-rollback.
  system
}

model ModuleVersion {
  id               String              @id @default(cuid())
  workspaceId      String
  remoteModuleId   String
  environmentId    String
  version          String
  url              String
  integrity        String
  storagePath      String?
  status           ModuleVersionStatus
  trafficPercent   Int?
  /// Canary targeting rules (M3.6): matching users always get the canary.
  targeting        Json?
  deployedBy       String
  deployedByType   ActorType
  commitSha        String?
  /// USG-02: bundle size at deploy (uploads; null for URL-only deploys).
  sizeBytes        BigInt?
  metadata         Json?
  dependencies     Json?
  exposes          Json?
  promotedFromId   String?
  promotedFromEnv  String?
  rolloutSchedule  Json?
  currentBandIndex Int?
  deployedAt       DateTime            @default(now())
  /// When the version last became the active one. Never set for a canary that was
  /// aborted, so "roll back to the previous version" skips it.
  activatedAt      DateTime?
  deletedAt        DateTime?
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  remoteModule     RemoteModule        @relation(fields: [remoteModuleId], references: [id], onDelete: Cascade)
  environment      Environment         @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  promotedFrom     ModuleVersion?      @relation("PromotedFrom", fields: [promotedFromId], references: [id])
  PromotedTo       ModuleVersion[]     @relation("PromotedFrom")

  @@index([workspaceId, remoteModuleId, environmentId, status])
  @@index([deletedAt])
}

model ApiKey {
  id             String    @id @default(cuid())
  workspaceId    String
  name           String
  keyHash        String
  prefix         String
  scopes         String[]
  moduleIds      String[]
  expiresAt      DateTime?
  gracePeriodEnd DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  /// The user who created it; null when an admin API key did (IaC-01, e.g. Terraform).
  createdBy      String?
  /// The workspace or org API key that created it, when not a user.
  createdByKeyId String?
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator        User?     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id              String    @id @default(cuid())
  userId          String
  /// sha256 of the raw token (high-entropy, so a fast hash is sufficient).
  tokenHash       String    @unique
  /// All tokens descending from one login. Reuse of a rotated token revokes the family.
  familyId        String
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  /// The identity provider of the login, e.g. 'github' or 'oidc:acme' (forced SSO).
  provider        String?
  /// SSO-08/27: the IdP's refresh token (sealed), re-checked while the session lives.
  ssoRefreshToken String?
  ssoCheckedAt    DateTime?
  /// SES-03: the session passed a second factor.
  mfaVerified     Boolean   @default(false)
  /// SES-02: where the session was last used from (shown in the session list).
  userAgent       String?
  ip              String?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

/// A login method linked to a user (GitHub account, email, OIDC subject, ...).
model Identity {
  id             String    @id @default(cuid())
  userId         String
  /// IdentityProvider id, e.g. 'github', 'email', 'oidc:acme'.
  provider       String
  /// Stable subject at the provider (GitHub user id, email address, OIDC `sub`).
  providerUserId String
  email          String
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// Passwordless email sign-in (magic link + one-time code).
model EmailLoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  codeHash  String
  /// Binds the link to the browser that requested it (login CSRF protection).
  nonceHash String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model WebhookEndpoint {
  id                 String              @id @default(cuid())
  workspaceId        String
  url                String
  events             String[]
  secret             String
  active             Boolean             @default(true)
  maxRetries         Int                 @default(5)
  backoffCeilingMs   Int                 @default(300000)
  paused             Boolean             @default(false)
  createdAt          DateTime            @default(now())
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  WebhookDeliveries  WebhookDelivery[]
  WebhookDeadLetters WebhookDeadLetter[]
}

model WebhookDelivery {
  id                String          @id @default(cuid())
  webhookEndpointId String
  workspaceId       String
  event             String
  payload           Json
  statusCode        Int?
  attempt           Int
  durationMs        Int?
  success           Boolean
  createdAt         DateTime        @default(now())
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WebhookDeadLetter {
  id                String          @id @default(cuid())
  workspaceId       String
  webhookEndpointId String
  event             String
  payload           Json
  finalStatusCode   Int?
  finalResponseBody String?
  totalAttempts     Int
  firstAttemptAt    DateTime
  exhaustedAt       DateTime
  retriedAt         DateTime?
  resolvedAt        DateTime?
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
}

/// AUD-05: no foreign key to Workspace: the audit trail outlives a deleted workspace (until
/// `HARMONIQ_AUDIT_RETENTION_DAYS`). RLS still scopes rows by `workspaceId`.
model AuditEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  actorId      String
  actorType    ActorType
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  ip           String?
  /// AUD-09: tamper evidence, set by a database trigger: the row's position in its scope's
  /// chain, the previous row's hash, and sha256 of the previous hash and this row.
  chainSeq     BigInt?
  prevHash     String?
  hash         String?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, chainSeq])
  @@index([workspaceId, actorId])
  @@index([workspaceId, action])
}

model WorkspaceConfig {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  oauthProvider      String    @default("github")
  oauthConfig        Json?
  storageProvider    String    @default("local")
  storageConfig      Json?
  logProvider        String    @default("console")
  logConfig          Json?
  oidcConfig         Json?
  samlConfig         Json?
  forceSso           Boolean   @default(false)
  trustedDomains     String[]
  defaultSsoRole     String    @default("viewer")
  scimEnabled        Boolean   @default(false)
  /// sha256 of the SCIM bearer token (SSO-24).
  scimTokenHash      String?   @unique
  scimTokenCreatedAt DateTime?
  plan               String    @default("hobby")
  /// PLN-06: `{ features?: { byob?: bool, … }, limits?: { members?: n | null, … } }`.
  planOverrides      Json?
  /// PLN-06: a trial: at this time the plan falls back to `basePlan`.
  planExpiresAt      DateTime?
  basePlan           String?
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ModuleOwnership {
  id                String          @id @default(cuid())
  workspaceId       String
  remoteModuleId    String
  workspaceMemberId String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  remoteModule      RemoteModule    @relation(fields: [remoteModuleId], references: [id], onDelete: Cascade)
  workspaceMember   WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([remoteModuleId, workspaceMemberId])
}

/// ALT-01..05: evaluated every minute against module health (or webhook deliveries).
model AlertRule {
  id              String        @id @default(cuid())
  workspaceId     String
  name            String        @default("")
  remoteModuleId  String?
  environmentId   String?
  condition       String
  threshold       Float
  /// `webhook` or `auto_rollback`.
  action          String
  actionConfig    Json
  windowMinutes   Int           @default(5)
  /// No decision below this many samples in the window.
  minSamples      Int           @default(20)
  /// Minimum time between two firings, against flapping.
  cooldownMinutes Int           @default(15)
  enabled         Boolean       @default(true)
  /// `ok` or `firing`.
  state           String        @default("ok")
  lastValue       Float?
  lastEvaluatedAt DateTime?
  lastTriggeredAt DateTime?
  /// Why the last action failed (e.g. the environment was frozen).
  lastError       String?
  createdAt       DateTime      @default(now())
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  remoteModule    RemoteModule? @relation(fields: [remoteModuleId], references: [id], onDelete: Cascade)
  environment     Environment?  @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([enabled])
}

model ManifestSnapshot {
  id            String      @id @default(cuid())
  workspaceId   String
  hostAppId     String
  environmentId String
  manifestJson  Json
  etag          String
  auditEventId  String
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostApp       HostApp     @relation(fields: [hostAppId], references: [id], onDelete: Cascade)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, hostAppId, environmentId, createdAt(sort: Desc)])
}

model ModuleHealthEvent {
  id             String       @id @default(cuid())
  workspaceId    String
  remoteModuleId String
  environmentId  String
  /// `stable` or `canary`, derived by the registry from the reported version.
  variant        String
  version        String?
  success        Boolean
  loadMs         Int?
  errorMessage   String?
  clientVersion  String?
  reportedAt     DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  remoteModule   RemoteModule @relation(fields: [remoteModuleId], references: [id], onDelete: Cascade)
  environment    Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, remoteModuleId, environmentId, reportedAt])
  @@index([environmentId, reportedAt])
}

/// Hourly health per module, environment and variant (HLT-04 sparklines). Raw events are
/// kept for 24 hours; rollups for 30 days.
model ModuleHealthRollup {
  id             String       @id @default(cuid())
  workspaceId    String
  remoteModuleId String
  environmentId  String
  variant        String
  hour           DateTime
  sampleCount    Int
  errorCount     Int
  p50LoadMs      Int?
  p95LoadMs      Int?
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  remoteModule   RemoteModule @relation(fields: [remoteModuleId], references: [id], onDelete: Cascade)
  environment    Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([remoteModuleId, environmentId, variant, hour])
  @@index([workspaceId, hour])
}

/// SSO-24/25: a user provisioned by the workspace's IdP over SCIM. Kept after
/// deprovisioning (`active: false` / `deletedAt`) so SSO can't silently re-add them.
/// SCIM users of a workspace or (ORG-07) of an organization: exactly one is set.
model ScimUser {
  id             String        @id @default(cuid())
  workspaceId    String?
  organizationId String?
  userId         String
  userName       String
  externalId     String?
  displayName    String?
  givenName      String?
  familyName     String?
  active         Boolean       @default(true)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@unique([workspaceId, userName])
  @@unique([organizationId, userId])
  @@unique([organizationId, userName])
  @@index([workspaceId, externalId])
}

/// SCIM groups; members are ScimUser ids. Group names map to roles like SSO groups.
model ScimGroup {
  id             String        @id @default(cuid())
  workspaceId    String?
  organizationId String?
  displayName    String
  externalId     String?
  memberIds      String[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, displayName])
  @@unique([organizationId, displayName])
}

model ScimAuditEvent {
  id             String   @id @default(cuid())
  workspaceId    String?
  organizationId String?
  operation      String
  scimUserId     String
  payload        Json
  statusCode     Int
  createdAt      DateTime @default(now())
  // AUD-05: no foreign keys, so SCIM history outlives a deleted workspace or organization.

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
}

model ApprovalPolicy {
  id                  String    @id @default(cuid())
  workspaceId         String
  environmentId       String
  requiredApprovers   Int       @default(1)
  eligibleRoles       String[]
  requireChangeTicket Boolean   @default(false)
  ticketUrlPattern    String?
  expiryHours         Int       @default(24)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, environmentId])
  @@index([workspaceId])
}

/// APR-04: a change waiting for approval. It is the API call itself (`method`, `path`,
/// `payload`), executed as the requester once approved, like a scheduled operation.
model DeploymentRequest {
  id                  String               @id @default(cuid())
  workspaceId         String
  moduleId            String
  environmentId       String
  /// `deploy`, `rollback`, `promote`, `canary_traffic`, `canary_promote`, `canary_abort`.
  type                String
  requestedBy         String
  requestedByType     ActorType            @default(user)
  method              String               @default("POST")
  path                String               @default("")
  payload             Json
  /// `pending_approval`, `executing`, `executed`, `failed`, `rejected` or `expired`.
  status              String
  requiredApprovers   Int                  @default(1)
  changeTicketId      String?
  changeTicketUrl     String?
  expiresAt           DateTime
  resolvedAt          DateTime?
  resolvedBy          String?
  /// APR-10: an owner executed it without the approvals.
  bypassed            Boolean              @default(false)
  bypassJustification String?
  /// `{ statusCode, body }` of the executed call.
  result              Json?
  /// The version the executed deploy or promote created (APR-18).
  resultVersionId     String?
  createdAt           DateTime             @default(now())
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  DeploymentApprovals DeploymentApproval[]

  @@index([workspaceId])
  @@index([status, expiresAt])
  @@index([resultVersionId])
}

model DeploymentApproval {
  id                  String            @id @default(cuid())
  deploymentRequestId String
  approverId          String
  decision            String
  comment             String?
  decidedAt           DateTime          @default(now())
  deploymentRequest   DeploymentRequest @relation(fields: [deploymentRequestId], references: [id], onDelete: Cascade)

  @@unique([deploymentRequestId, approverId])
}

model Organization {
  id                 String               @id @default(cuid())
  slug               String               @unique
  name               String
  plan               String               @default("hobby")
  /// PLN-06: as for workspaces.
  planOverrides      Json?
  planExpiresAt      DateTime?
  basePlan           String?
  /// ORG-05: inherited by workspaces without their own SSO.
  oidcConfig         Json?
  samlConfig         Json?
  forceSso           Boolean              @default(false)
  trustedDomains     String[]             @default([])
  /// ORG-07: `{ rules: [{ group, workspace, role }], adminGroups }`.
  provisioning       Json?
  scimEnabled        Boolean              @default(false)
  /// sha256 of the org SCIM bearer token.
  scimTokenHash      String?              @unique
  scimTokenCreatedAt DateTime?
  createdAt          DateTime             @default(now())
  deletedAt          DateTime?
  /// TLC-02/03: restorable by an instance admin until then; purged (slug released) after.
  purgeAfter         DateTime?
  /// TLC-04: every workspace of the organization refuses changes while set.
  suspendedAt        DateTime?
  suspendedReason    String?
  Workspaces         Workspace[]
  Members            OrganizationMember[]
  OrgApiKeys         OrgApiKey[]
  ScimUsers          ScimUser[]
  ScimGroups         ScimGroup[]
  VerifiedDomains    VerifiedDomain[]
  Policy             OrgPolicy?

  @@index([purgeAfter])
}

/// POL-01..08: organization-wide policy, edited by org admins. Workspaces may be stricter,
/// never weaker. Readable from the organization's workspaces (RLS), writable in org scope.
model OrgPolicy {
  organizationId       String       @id
  /// POL-02: `[{ environmentPattern, requiredApprovers, eligibleRoles, requireChangeTicket,
  /// ticketUrlPattern?, expiryHours }]`.
  approvalDefaults     Json         @default("[]")
  /// POL-03
  maxApiKeyDays        Int?
  allowedKeyScopes     String[]     @default([])
  /// POL-04
  minRetentionDays     Int?
  /// POL-05: `[{ id, environmentPattern, from?, until?, reason, override?: { until, reason, by } }]`.
  freezeWindows        Json         @default("[]")
  /// POL-06
  lockSso              Boolean      @default(false)
  /// SES-03: members signing in without SSO must use MFA.
  requireMfa           Boolean      @default(false)
  /// POL-07
  sessionMaxHours      Int?
  idleTimeoutMinutes   Int?
  /// POL-08: CIDR blocks; manifests and health only with `ipAllowlistManifests`.
  ipAllowlist          String[]     @default([])
  ipAllowlistManifests Boolean      @default(false)
  updatedAt            DateTime     @updatedAt
  updatedBy            String?
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

/// ORG-13: `hq_org_<id>_<secret>`; empty scopes mean every workspace / module of the org.
model OrgApiKey {
  id             String       @id @default(cuid())
  organizationId String
  keyHash        String
  name           String
  prefix         String       @default("")
  scopes         String[]     @default([])
  /// Workspace ids.
  workspaceScope String[]
  /// Module ids.
  moduleScope    String[]
  expiresAt      DateTime?
  /// TAD-05: set on the old key during rotation; valid only until then (as KEY-05).
  gracePeriodEnd DateTime?
  lastUsedAt     DateTime?
  createdBy      String?
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Org-level changes (members, workspaces, keys); workspace changes stay in AuditEvent.
/// AUD-05: no foreign key to Organization: the trail outlives a purged organization.
model OrganizationAuditEvent {
  id             String    @id @default(cuid())
  organizationId String
  actorType      ActorType
  actorId        String
  action         String
  resourceType   String
  resourceId     String
  metadata       Json?
  ip             String?
  /// AUD-09: tamper evidence, set by a database trigger: the row's position in its scope's
  /// chain, the previous row's hash, and sha256 of the previous hash and this row.
  chainSeq       BigInt?
  prevHash       String?
  hash           String?
  createdAt      DateTime  @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, chainSeq])
}

model InstanceConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String
}

/// INST-18: instance-level changes (config, admins, workspace suspension, users). Append-only.
model InstanceAuditEvent {
  id           String    @id @default(cuid())
  actorType    ActorType
  actorId      String
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  ip           String?
  /// AUD-09: tamper evidence, set by a database trigger: the row's position in its scope's
  /// chain, the previous row's hash, and sha256 of the previous hash and this row.
  chainSeq     BigInt?
  prevHash     String?
  hash         String?
  createdAt    DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([chainSeq])
}

model InstanceAdmin {
  id        String    @id @default(cuid())
  userId    String    @unique
  grantedBy String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkspaceStorageConfig {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  provider             String
  bucket               String
  region               String
  credentialsEncrypted Json
  /// BYOB-02: S3-compatible endpoint (MinIO, R2 …).
  endpoint             String?
  cdnPrefix            String?
  pathPrefix           String?
  /// BYOB-04/05: the last successful write-read-delete check.
  lastVerifiedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Kill switch (M3.6): a module disabled in one environment is marked `disabled` in the
/// manifest, so hosts stop loading it at once.
model ModuleEnvState {
  id             String       @id @default(cuid())
  workspaceId    String
  remoteModuleId String
  environmentId  String
  disabled       Boolean      @default(false)
  reason         String?
  updatedBy      String
  updatedAt      DateTime     @updatedAt
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  remoteModule   RemoteModule @relation(fields: [remoteModuleId], references: [id], onDelete: Cascade)
  environment    Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([remoteModuleId, environmentId])
  @@index([environmentId])
}

/// Scheduled operations (M3.6): an API call (deploy, promote, canary…) run at `runAt`,
/// as its creator, through the same route and checks as a manual call.
model ScheduledOperation {
  id            String    @id @default(cuid())
  workspaceId   String
  type          String
  /// For listings; the call itself is `method` + `path` + `body`.
  module        String?
  environment   String?
  description   String?
  method        String
  path          String
  body          Json
  runAt         DateTime
  /// `pending`, `running`, `done`, `failed` or `cancelled`.
  status        String    @default("pending")
  createdById   String
  createdByType ActorType
  startedAt     DateTime?
  finishedAt    DateTime?
  /// `{ statusCode, body }` of the call.
  result        Json?
  error         String?
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([workspaceId, runAt])
}

/// DOM-01/02: a domain claimed by an organization or a workspace (exactly one), proven
/// with a DNS TXT record. Many tenants may claim a domain, but only one can verify it:
/// `verifiedDomain` holds the domain while verified and is unique.
model VerifiedDomain {
  id             String        @id @default(cuid())
  domain         String
  organizationId String?
  workspaceId    String?
  /// Published as `harmoniq-verification=<token>` (not a secret: DNS is public).
  token          String
  verifiedAt     DateTime?
  verifiedDomain String?       @unique
  /// DOM-05: weekly re-checks; unverified after 14 days of failures.
  lastCheckedAt  DateTime?
  failingSince   DateTime?
  createdBy      String
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([domain, organizationId])
  @@unique([domain, workspaceId])
  @@index([domain])
}

/// TLC-06: a pending handover of a workspace's ownership or an organization's admin seat.
/// The recipient accepts; the sender then steps down (owner → admin, org_admin → org_member).
/// Exactly one of `workspaceId` / `organizationId` is set.
model OwnershipTransfer {
  id             String    @id @default(cuid())
  workspaceId    String?
  organizationId String?
  fromUserId     String
  toUserId       String
  expiresAt      DateTime
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([toUserId])
  @@index([workspaceId])
  @@index([organizationId])
}

/// PPL-01/02: an invitation to a workspace or an organization (exactly one). Pending ones
/// grant nothing; accepting (the link, or signing in with the invited email) creates the
/// membership. The token is sent by email and stored hashed.
model Invitation {
  id             String    @id @default(cuid())
  workspaceId    String?
  organizationId String?
  email          String
  /// A workspace role (owner, admin, developer, viewer) or an organization role.
  role           String
  tokenHash      String    @unique
  /// `user:<id>`, `apiKey:<id>` or `system:<what>`.
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedBy     String?
  revokedAt      DateTime?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([workspaceId])
  @@index([organizationId])
}

/// PPL-07: an organization member asks to join one of its workspaces.
model AccessRequest {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("viewer")
  message     String?
  /// `pending`, `approved` or `denied`.
  status      String    @default("pending")
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, status])
  @@index([userId])
}

/// USG-01: daily usage per workspace. Counters (`manifestRequests`, `deploys`,
/// `healthEvents`) are added up by each replica; levels (`storageBytes`, `members`,
/// `apiKeys`) are the nightly snapshot. Kept 13 months.
model UsageDaily {
  workspaceId      String
  day              DateTime @db.Date
  manifestRequests BigInt   @default(0)
  deploys          Int      @default(0)
  healthEvents     Int      @default(0)
  storageBytes     BigInt   @default(0)
  members          Int      @default(0)
  apiKeys          Int      @default(0)

  @@id([workspaceId, day])
  @@index([day])
}
