# ─── Database (Postgres) ──────────────────────────────────────────────────────
# App role: subject to Row-Level Security. Used for all tenant-scoped queries.
DATABASE_URL="postgresql://harmoniq_app:password@127.0.0.1:5433/harmoniq"
# Schema owner: runs migrations, background jobs, tenant resolution and instance admin.
# Not subject to RLS — never use it for queries on behalf of a tenant.
SYSTEM_DATABASE_URL="postgresql://harmoniq:password@127.0.0.1:5433/harmoniq"

# ─── Cache (Redis) ────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"
# redis | memory. "memory" is single-node only: invalidations don't reach other replicas.
CACHE_ADAPTER=redis

# ─── Registry ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
# Instance default storage for published manifests (workspaces may bring their own bucket):
# local (development default; served at /static) | s3 | none (production default)
STORAGE_ADAPTER=local
LOCAL_STORAGE_DIR="./data/storage"
# Public base URL of this registry (links to /static objects).
PUBLIC_URL="http://localhost:4000"
# For STORAGE_ADAPTER=s3 (S3_ENDPOINT for MinIO/R2; S3_PUBLIC_URL = CDN in front of the bucket):
# S3_BUCKET= S3_REGION= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_ENDPOINT= S3_PUBLIC_URL=
# Origin of the dashboard. Write/admin routes only accept CORS requests from here.
WEB_ORIGIN="http://localhost:3000"
# One-time token for the first-boot setup wizard (/admin/setup). Consumed on first use.
HARMONIQ_SETUP_TOKEN=""

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Shared by registry and web to sign/verify sessions. REQUIRED in production:
# min 32 random chars, e.g. `openssl rand -base64 48`. Dev falls back to a fixed value.
JWT_SECRET=""
# Encrypts credentials at rest (storage, SMTP, SSO). REQUIRED in production:
# exactly 32 random bytes, base64-encoded, e.g. `openssl rand -base64 32`.
HARMONIQ_ENCRYPTION_KEY=""

# ─── Sign-in (registry) ───────────────────────────────────────────────────────
# Which sign-in methods exist on this instance, comma-separated. Empty: every method
# whose credentials are configured below, plus "dev" when HARMONIQ_DEV_LOGIN=1.
# The admin panel can turn listed methods off, never on. Sessions from a method that is
# not allowed end at their next request. The registry refuses to start with an unknown
# method, or with "dev" in production.
#   github    GitHub OAuth (GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET, or the admin panel)
#   email     magic link + code (SMTP_URL, or the admin panel)
#   oidc      the instance IdP from OIDC_ISSUER / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET
#   sso-oidc  OIDC single sign-on that workspaces and organizations configure
#   sso-saml  SAML single sign-on that workspaces and organizations configure
#   dev       "sign in as any email", local development only
# Example for an enterprise IdP only: HARMONIQ_AUTH_METHODS="oidc"
HARMONIQ_AUTH_METHODS=""
# GitHub OAuth app. Callback URL: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Email sign-in (magic link + code). Without SMTP_URL, development logs emails to the
# registry console; production then offers no email sign-in.
SMTP_URL=""
MAIL_FROM="Harmoniq <no-reply@example.com>"
# Instance-wide OpenID Connect sign-in (Okta, Entra ID, Google, Keycloak…).
# Callback URL: ${APP_URL}/api/auth/callback/oidc
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_DISPLAY_NAME="Single sign-on"
# 1 = passwordless "sign in as any email" for local development. The registry refuses to
# start with this enabled in production. With HARMONIQ_AUTH_METHODS set, list "dev" there.
HARMONIQ_DEV_LOGIN=1

# ─── Limits and transport (registry) ─────────────────────────────────────────
# Writes per minute per credential (or IP). Sign-in, setup and health ingest have their own.
HARMONIQ_WRITE_RATE_LIMIT=300
# Not-found manifest answers per minute per client IP, across all workspaces (default 120).
HARMONIQ_MANIFEST_MISS_LIMIT=120
# PEM files: HTTPS with HTTP/2 (HTTP/1.1 still accepted). Leave empty behind a TLS proxy.
TLS_CERT_FILE=""
TLS_KEY_FILE=""
# Bearer token for GET /metrics (min 16 chars). Empty: public, so keep the port private.
HARMONIQ_METRICS_TOKEN=""
# 1 = label metrics by workspace slug (names your tenants to whoever can scrape).
HARMONIQ_METRICS_TENANT_LABELS=0
# Serve /metrics on this port only, e.g. 9464 (not on the API port). Empty: API port.
HARMONIQ_METRICS_PORT=""
# Days unverified trusted SSO domains keep working after upgrading (DOM-04). 0 = enforce now.
HARMONIQ_DOMAIN_GRACE_DAYS=30
# Days a deleted workspace's audit events are kept, counted from each event (AUD-05).
HARMONIQ_AUDIT_RETENTION_DAYS=400
# Days a deleted workspace or organization can be restored before it is purged (TLC-02).
HARMONIQ_TENANT_RESTORE_DAYS=30

# ─── Dashboard (web) ──────────────────────────────────────────────────────────
# The dashboard must use the same JWT_SECRET as the registry.
# Server-side URL the dashboard uses to reach the registry API.
REGISTRY_URL="http://localhost:4000"
# Registry URL shown in dashboard snippets, when it differs from REGISTRY_URL (e.g. internal).
PUBLIC_REGISTRY_URL=""
# Public URL of the dashboard (OAuth callbacks, email links). Must match WEB_ORIGIN.
APP_URL="http://localhost:3000"
