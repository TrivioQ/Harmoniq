# Database (Postgres)
DATABASE_URL="postgresql://harmoniq_app:password@127.0.0.1:5433/harmoniq"

# Cache (Redis)
REDIS_URL="redis://localhost:6380"

# Harmoniq Registry configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
CACHE_ADAPTER=redis # or memory
STORAGE_ADAPTER=local # or s3, gcs

# JWT Secret (generate a random string for production)
JWT_SECRET="super-secret-jwt-key-change-me"
